# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# Gemini is the only provider used by this project.
STRUCTURING_PROVIDER=gemini
STRUCTURING_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CONCURRENCY=3
GEMINI_REQUEST_INTERVAL_SECONDS=4.2
LEGAL_STRUCTURING_BATCH_PAGES=3

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=50
EMBEDDING_REQUEST_INTERVAL_SECONDS=4.2

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.3
